{
  "name": "fortrabbit/craft-auto-migrate",
  "description": "Runs migrations automatically",
  "homepage": "https://www.fortrabbit.com/software/craft-cms",
  "support": {
    "docs": "https://github.com/fortrabbit/craft-auto-migrate/blob/master/README.md",
    "source": "https://github.com/fortrabbit/craft-auto-migrate",
    "issues": "https://github.com/fortrabbit/craft-auto-migrate/issues"
  },
  "keywords": ["composer", "development", "craftcms"],
  "type": "composer-plugin",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "fortrabbit\\CraftAutoMigrate\\": "src"
    }
  },
  "authors": [
    {
      "name": "Oliver Stark",
      "homepage": "https://www.fortrabbit.com/"
    }
  ],
  "require": {
    "php": "^8.0",
    "composer-plugin-api": "^1.0 || ^2.0"
  },
  "require-dev": {
    "composer/composer": "^1.10.22 || ^2.1.9"
  },
  "extra": {
    "class": "fortrabbit\\CraftAutoMigrate\\Plugin"
  }
}
